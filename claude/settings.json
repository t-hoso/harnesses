{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git -C * add *)",
      "Bash(git branch *)",
      "Bash(git -C * branch *)",
      "Bash(git status *)",
      "Bash(git -C * status *)",
      "Bash(pnpm test *)",
      "Bash(git switch *)",
      "Bash(git -C * switch *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/classify-intent.sh",
            "statusMessage": "Classifying intent..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-compound-commands.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/warn-git-checkout.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-commit-message.py"
          }
        ]
      }
    ]
  }
}
